{
  "name": "screeps-automation",
  "version": "1.0.0",
  "description": "Screeps automation scripts",
  "main": "dist/main.js",
  "scripts": {
    "build": "rollup -c",
    "deploy": "rollup -c && node scripts/deploy.mjs",
    "deploy:sim": "rollup -c && node scripts/deploy.mjs",
    "watch": "rollup -cw",
    "test": "vitest run",
    "realm": "vite --config viewer/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenGonzalez/screeps-automation.git"
  },
  "author": "StevenGonzalez",
  "license": "MIT",
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/screeps": "^3.3.8",
    "rollup": "^2.79.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.3.3",
    "vite": "^6",
    "vitest": "^3"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "resolutions": {
    "vite": "^6"
  }
}
